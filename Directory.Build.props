<Project>
  <PropertyGroup>
    <!-- 绕过 .NET 10 原生编译器宿主的 CET 崩溃（本机 Win10 19045 长期未更新，缺 2024+ 补丁
         导致用户态 CET 不完整，原生 csc.exe / VBCSCompiler.exe 启动即自杀）：
         1) Csc 任务改用 tools/csc-shim/csc.cmd，内部走 dotnet exec csc.dll；
         2) 禁用共享编译，避免拉起同样会崩的 VBCSCompiler.exe。
         本机安装 Windows 更新后，删除本文件与 tools/csc-shim 即可恢复正常工具链。 -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <CscToolPath>$(MSBuildThisFileDirectory)tools\csc-shim\</CscToolPath>
    <CscToolExe>csc.cmd</CscToolExe>
  </PropertyGroup>
</Project>
