<UserControl x:Class="LesTool.Platform.Controls.CaptionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="{StaticResource CaptionHeight}"
             Focusable="False">
    <!-- 自绘标题栏：底色即窗口主题背景；空白区由 WindowChrome 接管拖拽/双击最大化/右键系统菜单 -->
    <UserControl.Resources>
        <!-- 标题栏按钮特例：44x32 内缩圆角块悬停（参考 Win11 悬停效果），覆盖全局隐式按钮样式（DESIGN.md 已登记） -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 根必须有背景色（透明也行），否则命中区只剩图标的线条 -->
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="{StaticResource CornerRadiusControl}"
                                    Background="{DynamicResource NavHoverBackground}"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource NavSelectedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 关闭按钮：hover 红色圆角块淡入（Windows 惯例） -->
        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="{StaticResource CornerRadiusControl}"
                                    Background="#C42B1C" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#B2271B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource WindowBackground}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMinimizeClick" ToolTip="最小化">
                <!-- 线条图标必须给显式 10x10 画布：纯水平线几何高度为 0，靠几何居中会偏 -->
                <Path Data="M 0,5 H 10" Width="10" Height="10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
            <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMaximizeClick" ToolTip="最大化 / 还原">
                <!-- 圆角方框用 Border 画：Path 画不了圆角 -->
                <Grid Width="10" Height="10">
                    <Border x:Name="IconMax"
                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            BorderThickness="1" CornerRadius="2"/>
                    <Grid x:Name="IconRestore" Visibility="Collapsed">
                        <Border Width="7" Height="7" Margin="0,1,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                BorderThickness="1" CornerRadius="2"/>
                        <Border Width="7" Height="7" Margin="0,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                BorderThickness="1" CornerRadius="2"/>
                    </Grid>
                </Grid>
            </Button>
            <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButtonStyle}" Click="OnCloseClick" ToolTip="关闭">
                <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5" Width="10" Height="10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Image Source="pack://application:,,,/Assets/app.ico"
                   Width="16" Height="16" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </DockPanel>
</UserControl>
