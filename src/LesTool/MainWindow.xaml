<Window x:Class="LesTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LesTool.Platform.Controls;assembly=LesTool.Platform"
        Title="LesTool"
        Width="980" Height="640"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource LesWindowStyle}">
    <Window.Resources>
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GroupForeground}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="Margin" Value="24,20,12,6"/>
        </Style>
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource NavItemForeground}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="10,1" Background="Transparent">
                            <Border x:Name="Selected" CornerRadius="{StaticResource CornerRadiusControl}"
                                    Background="{DynamicResource NavSelectedBackground}" Opacity="0"/>
                            <Border x:Name="Hover" CornerRadius="{StaticResource CornerRadiusControl}"
                                    Background="{DynamicResource NavHoverBackground}" Opacity="0"/>
                            <Border Padding="14,9">
                                <Grid>
                                    <Rectangle x:Name="Indicator" Width="3" RadiusX="1.5" RadiusY="1.5"
                                               HorizontalAlignment="Left" Fill="{DynamicResource NavAccent}" Visibility="Collapsed"/>
                                    <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavSelectedForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <controls:CaptionBar DockPanel.Dock="Top"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <!-- 左侧菜单 -->
        <Border Grid.Column="0" Background="{DynamicResource MenuBackground}"
                BorderBrush="{DynamicResource MenuBorderColor}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NavMenu" Margin="0,14,0,20">
                    <TextBlock Text="LesTool" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandForeground}" Margin="24,0,0,4"/>

                    <TextBlock Text="触发场景" Style="{StaticResource GroupHeaderStyle}"/>
                    <RadioButton x:Name="NavRadial" Style="{StaticResource NavItemStyle}" Content="轮盘手势" Tag="radial" Checked="OnNavChecked"/>
                    <RadioButton Style="{StaticResource NavItemStyle}" Content="快捷键" Tag="hotkey" Checked="OnNavChecked"/>
                    <RadioButton Style="{StaticResource NavItemStyle}" Content="托盘常驻" Tag="tray" Checked="OnNavChecked"/>
                    <RadioButton Style="{StaticResource NavItemStyle}" Content="右键菜单" Tag="contextmenu" Checked="OnNavChecked"/>
                    <RadioButton Style="{StaticResource NavItemStyle}" Content="事件触发" Tag="event" Checked="OnNavChecked"/>

                    <TextBlock Text="动作" Style="{StaticResource GroupHeaderStyle}"/>
                    <RadioButton Style="{StaticResource NavItemStyle}" Content="后台动作" Tag="bgaction" Checked="OnNavChecked"/>
                    <RadioButton Style="{StaticResource NavItemStyle}" Content="面板动作" Tag="panel" Checked="OnNavChecked"/>

                    <TextBlock Text="其他" Style="{StaticResource GroupHeaderStyle}"/>
                    <RadioButton Style="{StaticResource NavItemStyle}" Content="设置" Tag="settings" Checked="OnNavChecked"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

            <!-- 右侧主体内容 -->
            <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False"/>
        </Grid>
    </DockPanel>
</Window>
