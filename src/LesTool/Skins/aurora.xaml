    <SolidColorBrush x:Key="NavAccent" Color="#FFB391FF"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FF0F1123"/>
    <SolidColorBrush x:Key="CardBackground" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderColor" Color="#1EFFFFFF"/>
