<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 皮肤包「深空极光」：由 tools/emit_themes.py 从 design-skins.json 生成（勿手改；改 JSON 后重跑）。
         部署位置 themes\aurora.xaml；热重载=直接保存本文件。缺省键热加载时回落内置深色。
         对比度门禁：14 对全过（透明色按叠加实算）。 -->

    <sys:String x:Key="SkinMeta.Id">aurora</sys:String>
    <sys:String x:Key="SkinMeta.Name">深空极光</sys:String>
    <sys:Boolean x:Key="SkinMeta.IsLight">false</sys:Boolean>
    <sys:Boolean x:Key="SkinMeta.Acrylic">false</sys:Boolean>
    <RadialGradientBrush x:Key="WindowGlowOverlay" Center="0.82,0.02" GradientOrigin="0.82,0.02" RadiusX="0.90" RadiusY="0.65">
        <GradientStop Color="#5C5E50E1" Offset="0"/>
        <GradientStop Color="#005E50E1" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="WindowBackground" Color="#FF21243B"/>
    <SolidColorBrush x:Key="WindowBorderColor" Color="#22FFFFFF"/>
