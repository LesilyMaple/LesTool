<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 皮肤包「Fluent 2」：由 tools/emit_themes.py 从 design-skins.json 生成（勿手改；改 JSON 后重跑）。
         部署位置 themes\fluent.xaml；热重载=直接保存本文件。缺省键热加载时回落内置深色。
         对比度门禁：14 对全过（透明色按叠加实算）。 -->

    <sys:String x:Key="SkinMeta.Id">fluent</sys:String>
    <sys:String x:Key="SkinMeta.Name">Fluent 2</sys:String>
    <sys:Boolean x:Key="SkinMeta.IsLight">true</sys:Boolean>
    <sys:Boolean x:Key="SkinMeta.Acrylic">false</sys:Boolean>
    <SolidColorBrush x:Key="WindowBackground" Color="#FFECF1F4"/>
