<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 皮肤包「玻璃拟态」：由 tools/emit_themes.py 从 design-skins.json 生成（勿手改；改 JSON 后重跑）。
         部署位置 themes\glass.xaml；热重载=直接保存本文件。缺省键热加载时回落内置深色。
         对比度门禁：14 对全过（透明色按叠加实算）。 -->

    <sys:String x:Key="SkinMeta.Id">glass</sys:String>
    <sys:String x:Key="SkinMeta.Name">玻璃拟态</sys:String>
    <sys:Boolean x:Key="SkinMeta.IsLight">false</sys:Boolean>
    <sys:Boolean x:Key="SkinMeta.Acrylic">false</sys:Boolean>
    <RadialGradientBrush x:Key="WindowGlowOverlay" Center="0.82,0.05" GradientOrigin="0.82,0.05" RadiusX="0.85" RadiusY="0.60">
        <GradientStop Color="#475E50E1" Offset="0"/>
        <GradientStop Color="#005E50E1" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="WindowBackground" Color="#FF202441"/>
    <SolidColorBrush x:Key="WindowBorderColor" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#FF0E1027"/>
    <SolidColorBrush x:Key="MenuBorderColor" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="BrandForeground" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#C2FFFFFF"/>
    <SolidColorBrush x:Key="TextHint" Color="#A4FFFFFF"/>
    <SolidColorBrush x:Key="GroupForeground" Color="#9AFFFFFF"/>
    <SolidColorBrush x:Key="NavItemForeground" Color="#B0FFFFFF"/>
    <SolidColorBrush x:Key="NavHoverBackground" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="NavSelectedBackground" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="NavSelectedForeground" Color="#F0FFFFFF"/>
    <SolidColorBrush x:Key="NavAccent" Color="#FFFECA8D"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FF0E1027"/>
    <SolidColorBrush x:Key="CardBackground" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderColor" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="ButtonBorderColor" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#F0FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#2AFFFFFF"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#38FFFFFF"/>
