    <sys:String x:Key="SkinMeta.Name">暖纸陶土</sys:String>
    <sys:Boolean x:Key="SkinMeta.IsLight">true</sys:Boolean>
    <sys:Boolean x:Key="SkinMeta.Acrylic">false</sys:Boolean>
