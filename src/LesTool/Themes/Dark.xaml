<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题（默认） -->

    <SolidColorBrush x:Key="WindowBackground" Color="#202028"/>
    <SolidColorBrush x:Key="WindowBorderColor" Color="#3A3A4A"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#17171E"/>
    <SolidColorBrush x:Key="MenuBorderColor" Color="#2A2A36"/>

    <SolidColorBrush x:Key="BrandForeground" Color="#E8E8F0"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#C8C8D4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8A8A9A"/>
    <SolidColorBrush x:Key="TextHint" Color="#5F5F72"/>

    <SolidColorBrush x:Key="GroupForeground" Color="#78788C"/>
    <SolidColorBrush x:Key="NavItemForeground" Color="#B8B8C6"/>
    <SolidColorBrush x:Key="NavHoverBackground" Color="#26262F"/>
    <SolidColorBrush x:Key="NavSelectedBackground" Color="#2E2E3E"/>
    <SolidColorBrush x:Key="NavSelectedForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavAccent" Color="#7C9AFF"/>

    <SolidColorBrush x:Key="CardBackground" Color="#26262E"/>
    <SolidColorBrush x:Key="CardBorderColor" Color="#343442"/>

    <SolidColorBrush x:Key="ButtonBackground" Color="#3A3A4A"/>
    <SolidColorBrush x:Key="ButtonBorderColor" Color="#5A5A72"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#424254"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#4A4A5E"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>

    <!-- 音量混音器滑杆（DESIGN.md 特例 MixerSliderStyle 引用）：轨道/圆点/静音弱化填充 -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#2E2E38"/>
    <SolidColorBrush x:Key="SliderThumbBrush" Color="#E8E8F0"/>
    <SolidColorBrush x:Key="SliderMutedFillBrush" Color="#597C9AFF"/>

    <!-- 命令面板（面板窗一档）：跟主题的浮层表面，微透出底色 -->
    <SolidColorBrush x:Key="PanelBackground" Color="#F2202028"/>

    <!-- 录制预览窗底部控制条（视频区保持黑色，播放器惯例） -->
    <SolidColorBrush x:Key="PlayerBarBackground" Color="#E6101010"/>

    <!-- 截图工具栏/录制控制条等悬浮条：深浅两套，工具栏随主题切换 -->
    <SolidColorBrush x:Key="OverlayBarBackground" Color="#E6101010"/>
    <SolidColorBrush x:Key="OverlayIconStroke" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayTextBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="OverlayActiveBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="OverlaySeparator" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="OverlaySeparatorStrong" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="OverlaySliderTrack" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="OverlaySliderFill" Color="#80FFFFFF"/>
</ResourceDictionary>
