<UserControl x:Class="LesTool.Views.Pages.HotkeySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Name="RootPanel" Margin="0,32,0,0">
        <TextBlock x:Name="SectionTitle" Text="快捷键" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"/>
        <TextBlock x:Name="SectionHint" Text="点击键位后按下组合键即绑定；Backspace 清除、Esc 取消。改动即时生效并保存。"
                   FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,0"
                   Foreground="{DynamicResource TextHint}"/>
        <StackPanel x:Name="RowsPanel" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
