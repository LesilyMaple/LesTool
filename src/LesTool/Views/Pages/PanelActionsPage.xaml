<UserControl x:Class="LesTool.Views.Pages.PanelActionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="36,32,36,0">
        <TextBlock Text="面板动作" FontSize="{DynamicResource FontSizeTitle}"
                   Foreground="{DynamicResource BrandForeground}"/>
        <TextBlock Text="以全屏面板形式呼出的动作。"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>

        <StackPanel x:Name="ScreenshotSection" Margin="0,24,0,0">
            <Button Content="截图" Width="110" HorizontalAlignment="Left" Click="OnScreenshotClick"/>
            <TextBlock Text="框选区域 → 复制 / 保存 / 钉图"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextHint}" Margin="2,10,0,0"/>
        </StackPanel>
        <TextBlock x:Name="PluginMissingHint" Visibility="Collapsed"
                   Text="截图插件未安装：命令「截图（框选）」不可用。"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource TextHint}" Margin="2,16,0,0"/>

        <TextBlock Text="更多面板动作开发中"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource TextHint}" Margin="2,16,0,0"/>
    </StackPanel>
</UserControl>
