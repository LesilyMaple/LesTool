<UserControl x:Class="LesTool.Views.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="{DynamicResource FontSizeTitle}"
                   Foreground="{DynamicResource BrandForeground}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="MessageText" FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
    </StackPanel>
</UserControl>
