<UserControl x:Class="LesTool.Views.Pages.RadialGesturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 页内 tab：外观对齐主窗口导航项（hover 100/150ms 过渡 + 选中下划线） -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource NavItemForeground}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" MinHeight="36" MinWidth="104">
                            <Border x:Name="Hover" CornerRadius="{StaticResource CornerRadiusControl}"
                                    Background="{DynamicResource NavHoverBackground}"
                                    Opacity="0" Margin="0,0,0,3" IsHitTestVisible="False"/>
                            <Border x:Name="Selected" CornerRadius="{StaticResource CornerRadiusControl}"
                                    Background="{DynamicResource NavSelectedBackground}"
                                    Opacity="0" Margin="0,0,0,3" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle x:Name="Indicator" Height="2" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="28"
                                       Fill="{DynamicResource NavAccent}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource NavSelectedForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="{StaticResource PagePadding}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="轮盘手势" FontSize="{DynamicResource FontSizeTitle}"
                       Foreground="{DynamicResource BrandForeground}"/>
            <TextBlock Text="按住右键拖动唤出轮盘，划到扇区松开即执行。基础设置管超时与尺寸；动作设置管盘面内容与按软件场景。改动即时保存，下次唤出生效。"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <RadioButton x:Name="BasicTab" Style="{StaticResource TabButtonStyle}"
                             Content="基础设置" Checked="OnBasicTabChecked"/>
                <RadioButton x:Name="ActionTab" Style="{StaticResource TabButtonStyle}"
                             Content="动作设置" IsChecked="True" Margin="8,0,0,0" Checked="OnActionTabChecked"/>
            </StackPanel>
        </StackPanel>

        <Grid Margin="0,24,0,0">
            <!-- Tab 一：基础设置 -->
            <ScrollViewer x:Name="BasicPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusOverlay}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="触发与交互" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock FontSize="{DynamicResource FontSizeCaption}" LineHeight="20"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0">
                                <Run Text="•  唤出：按住鼠标右键拖动（位移超过 5 像素）"/>
                                <LineBreak/>
                                <Run Text="•  执行：划到扇区上松开右键（命令与快捷键/面板共用）"/>
                                <LineBreak/>
                                <Run Text="•  取消：划出盘面、按 Esc、点左键、或超时未选"/>
                                <LineBreak/>
                                <Run Text="•  扩展圈：划出盘面外按方向松开触发（实际不可见，仅全局场景生效）"/>
                                <LineBreak/>
                                <Run Text="•  禁用：应用场景勾选禁用后，手势退化为普通右键"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusOverlay}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="超时自动收起" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="轮盘显示后一直未选择，超过该时长自动收起。"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextHint}" Margin="0,6,0,0"/>
                            <StackPanel x:Name="TimeoutPanel" Orientation="Horizontal" Margin="2,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusOverlay}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="轮盘尺寸" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="三档直径（程序内单位；屏幕上按系统缩放显示，150% 缩放下约为标注值的 1.5 倍）。"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextHint}" Margin="0,6,0,0"/>
                            <StackPanel x:Name="SizePanel" Orientation="Horizontal" Margin="2,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Tab 二：动作设置 -->
            <DockPanel x:Name="ActionPanel">
                <Border DockPanel.Dock="Left" Width="248" Margin="0,0,16,0" Padding="12"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusOverlay}">
                    <DockPanel>
                        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" TextChanged="OnFilterChanged"/>
                        <CheckBox x:Name="DisableCheck" DockPanel.Dock="Top" Margin="2,12,0,2"
                                  Content="在此软件下禁用轮盘菜单"
                                  Checked="OnDisableChanged" Unchecked="OnDisableChanged"/>
                        <Button x:Name="AddAppButton" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                                Content="＋ 添加应用场景" Click="OnAddAppClick"/>
                        <ScrollViewer Margin="0,12,0,10" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SceneList"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Padding="24,16,24,16"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusOverlay}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel HorizontalAlignment="Center" MinWidth="620" Margin="4">
                            <TextBlock x:Name="EditorTitle" Text="全局场景" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <Canvas x:Name="WheelHost" Width="600" Height="600" Margin="0,16,0,0"
                                    HorizontalAlignment="Center" Background="Transparent"/>
                            <TextBlock x:Name="EditorHint" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextHint}" Margin="0,16,0,4"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>

        <!-- 槽位命令选择弹层：打开时按当前场景上下文重建 -->
        <Popup x:Name="SlotPopup" Placement="MousePoint" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusOverlay}" Padding="8" Margin="0,0,8,16" MinWidth="230">
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SlotList"/>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- 添加应用弹层：枚举当前有窗口的应用 -->
        <Popup x:Name="AppPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=AddAppButton}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusOverlay}" Padding="8" Margin="0,0,8,16" MinWidth="280">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AppList"/>
                </ScrollViewer>
            </Border>
        </Popup>
    </DockPanel>
</UserControl>
