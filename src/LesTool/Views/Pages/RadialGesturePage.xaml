<UserControl x:Class="LesTool.Views.Pages.RadialGesturePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="36,32,36,0">
        <TextBlock Text="轮盘手势" FontSize="{DynamicResource FontSizeTitle}"
                   Foreground="{DynamicResource BrandForeground}"/>
        <TextBlock Text="按住右键拖动，在指针处唤出轮盘；松开收起。"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>

        <Border Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusOverlay}" Padding="16,14" Margin="0,24,0,0"
                MaxWidth="520" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="当前触发方式" FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" LineHeight="22">
                    <Run Text="•  唤出：按住鼠标右键并移动，位移超过 5 像素"/>
                    <LineBreak/>
                    <Run Text="•  收起：松开右键"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="轮盘内容与灵敏度配置开发中"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource TextHint}" Margin="2,16,0,0"/>
    </StackPanel>
</UserControl>
