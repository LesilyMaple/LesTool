<UserControl x:Class="LesTool.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ThemeOptionStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="0,0,12,0">
                            <Border Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1.5"
                                    CornerRadius="8"/>
                            <Border x:Name="Hover" Background="{DynamicResource NavHoverBackground}"
                                    CornerRadius="8" Opacity="0"/>
                            <Border x:Name="SelectedRing" BorderBrush="{DynamicResource NavAccent}"
                                    BorderThickness="1.5" CornerRadius="8" Opacity="0"/>
                            <Border Padding="10">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedRing" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedRing" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="36,32,36,0">
        <TextBlock Text="设置" FontSize="{DynamicResource FontSizeTitle}"
                   Foreground="{DynamicResource BrandForeground}"/>
        <TextBlock Text="应用级选项，更改即时生效。"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>

        <TextBlock Text="颜色主题" FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,28,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <RadioButton x:Name="DarkOption" Style="{StaticResource ThemeOptionStyle}"
                         Tag="Dark" Checked="OnThemeChecked">
                <StackPanel>
                    <!-- 迷你预览：硬编码该主题代表色，不随当前主题变 -->
                    <Border Width="112" Height="64" CornerRadius="4" Background="#202028">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#2A2A32"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#17171E"/>
                                <Border Grid.Column="1" Background="#26262E" Margin="4">
                                    <Rectangle Width="34" Height="8" Fill="#3A3A4A" RadiusX="2" RadiusY="2"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="深色" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="LightOption" Style="{StaticResource ThemeOptionStyle}"
                         Tag="Light" Checked="OnThemeChecked">
                <StackPanel>
                    <Border Width="112" Height="64" CornerRadius="4" Background="#F4F4F8"
                            BorderBrush="#DCDCE4" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#FFFFFF"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#ECECF2"/>
                                <Border Grid.Column="1" Background="#FFFFFF" Margin="4">
                                    <Rectangle Width="34" Height="8" Fill="#D8D8E6" RadiusX="2" RadiusY="2"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="浅色" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="SystemOption" Style="{StaticResource ThemeOptionStyle}"
                         Tag="System" Checked="OnThemeChecked">
                <StackPanel>
                    <Border Width="112" Height="64" CornerRadius="4" BorderThickness="1">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2A2A32" Offset="0"/>
                                <GradientStop Color="#2A2A32" Offset="0.5"/>
                                <GradientStop Color="#DCDCE4" Offset="0.5"/>
                                <GradientStop Color="#DCDCE4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 左半：深色预览 -->
                            <Border Background="#202028">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#2A2A32"/>
                                    <Border Grid.Row="1" Background="#26262E" Margin="0,4,2,4"/>
                                </Grid>
                            </Border>
                            <!-- 右半：浅色预览 -->
                            <Border Grid.Column="1" Background="#F4F4F8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#FFFFFF"/>
                                    <Border Grid.Row="1" Background="#FFFFFF" Margin="2,4,0,4"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="跟随系统" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>
    </StackPanel>
</UserControl>
