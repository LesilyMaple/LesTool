<UserControl x:Class="LesTool.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OptionCardStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="0,0,12,0">
                            <Border Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadiusOverlay}"/>
                            <Border x:Name="Hover" Background="{DynamicResource NavHoverBackground}"
                                    CornerRadius="{StaticResource CornerRadiusOverlay}" Opacity="0"/>
                            <Border x:Name="SelectedRing" BorderBrush="{DynamicResource NavAccent}"
                                    BorderThickness="2" CornerRadius="{StaticResource CornerRadiusOverlay}" Opacity="0"/>
                            <Border Padding="10">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedRing" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedRing" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="SettingsRoot" Margin="32,24,32,0">
        <TextBlock Text="设置" FontSize="{DynamicResource FontSizeTitle}"
                   Foreground="{DynamicResource BrandForeground}"/>
        <TextBlock Text="应用级选项，更改即时生效。"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>

        <TextBlock Text="颜色主题" FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,32,0,0"/>
        <TextBlock Text="深色与浅色各选一套皮肤；跟随系统开启时按 Windows 深浅自动切换，关闭时用手动点选的那套。"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>

        <CheckBox x:Name="FollowSystemCheck" Content="跟随系统主题" Cursor="Hand" Margin="0,16,0,0"
                  Checked="OnFollowSystemChanged" Unchecked="OnFollowSystemChanged"/>

        <TextBlock Text="深色主题" FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,24,0,0"/>
        <!-- 两组皮肤卡片由代码后置生成（themes\ 目录实扫；预览色块取皮肤真实画刷） -->
        <StackPanel x:Name="DarkOptionsPanel" Orientation="Horizontal" Margin="0,12,0,0"/>

        <TextBlock Text="浅色主题" FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,24,0,0"/>
        <StackPanel x:Name="LightOptionsPanel" Orientation="Horizontal" Margin="0,12,0,0"/>

        <TextBlock Text="自动清理日志" FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,32,0,0"/>
        <TextBlock Text="日志按天分文件存放；按所选周期删除更早的日志，更改即时生效。"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <RadioButton x:Name="LogDailyOption" Style="{StaticResource OptionCardStyle}"
                         Tag="Daily" Checked="OnLogRetentionChecked">
                <StackPanel Width="112">
                    <TextBlock Text="每天" FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="保留最近 1 天" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="LogWeeklyOption" Style="{StaticResource OptionCardStyle}"
                         Tag="Weekly" Checked="OnLogRetentionChecked">
                <StackPanel Width="112">
                    <TextBlock Text="每周" FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="保留最近 7 天" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="LogMonthlyOption" Style="{StaticResource OptionCardStyle}"
                         Tag="Monthly" Checked="OnLogRetentionChecked">
                <StackPanel Width="112">
                    <TextBlock Text="每月" FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="保留最近 30 天" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>
    </StackPanel>
</UserControl>
