<Window x:Class="LesTool.Plugin.ClipboardHistory.ClipboardPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LesTool.Plugin.ClipboardHistory"
        xmlns:platform="clr-namespace:LesTool.Platform.Controls;assembly=LesTool.Platform"
        platform:GlassWindow.Enabled="True"
        platform:NoSystemMenu.Enabled="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="880"
        WindowStartupLocation="Manual"
        Focusable="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <!-- 剪切板历史浮窗（面板窗一档表面：跟主题 + 圆角 8 + 1px 描边），光标所在显示器顶部居中。
         Root 常态 Opacity=0：预创建预热与淡出后均不可见。
         结构：上搜索条（同命令面板）+ 中历史列表（虚拟化；固定区置顶带节标题）
         + 下页脚提示。行 = CommandItemStyle（hover 100/150ms 过渡）+ 容器选中描边。 -->
    <Window.Resources>
        <!-- 转换器必须放在所有模板之前：模板是延迟内容，其 StaticResource 只看得见
             定义位置之前的资源条目（2026-10-20 线上炸过：放在模板后 → 行实例化时
             "找不到 BoolToVis" 异常风暴，面板开不出来且日志刷爆拖死 UI） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="HeaderTemplate" DataType="{x:Type local:HeaderRow}">
            <TextBlock Text="{Binding Title}" Margin="2,8,0,2" IsHitTestVisible="False"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextHint}"/>
        </DataTemplate>

        <!-- 历史行：多选勾 | 内容预览（按 Kind 三选一显示；类型图标不要——内容本身已自明，
             2026-10-20 用户拍板）| 时间+悬停操作（纯文本/固定/删除）。
             根 Grid 必须给透明底：无背景的容器空白区不参与命中，点空白会点不中行（2026-10-20 用户反馈） -->
        <DataTemplate x:Key="ClipTemplate" DataType="{x:Type local:ClipItem}">
            <Button Style="{StaticResource CommandItemStyle}" Padding="10,7" Click="OnRowActivate">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 多选合并标记（Ctrl+点击切换） -->
                    <TextBlock Grid.Column="0" Text="&#xE73E;" Margin="0,1,6,0" VerticalAlignment="Top"
                               FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource NavAccent}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Marked}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <!-- 文本预览：两行封顶 -->
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="40"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextPrimary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Text">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 图片预览：48 DIP 高缩略 -->
                        <Image Height="48" Stretch="Uniform" HorizontalAlignment="Left"
                               Source="{Binding Converter={StaticResource PreviewConverter}}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- 文件预览：数量 + 名单单行截断 -->
                        <TextBlock Text="{Binding FilesSummary}" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextPrimary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Files">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                        <!-- 富文本徽标：强调色描边小胶囊，一眼识别"贴回会带格式" -->
                        <Border CornerRadius="{StaticResource CornerRadiusControl}"
                                BorderBrush="{DynamicResource NavAccent}" BorderThickness="1"
                                Padding="5,0" Margin="0,0,0,3" HorizontalAlignment="Right"
                                Visibility="{Binding IsRich, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="富文本" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource NavAccent}"/>
                        </Border>
                        <TextBlock Text="{Binding AgeText}" HorizontalAlignment="Right"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextHint}"/>
                        <!-- 悬停露出：纯文本（富文本行）/ 固定 / 删除（淡入 100ms 淡出 150ms，符合状态过渡约束） -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- 纯文本粘贴（仅富文本行露出：丢弃格式只贴文字） -->
                            <Button Click="OnPastePlain" Width="24" Height="24" MinHeight="0" Padding="0"
                                    Margin="0,0,2,0"
                                    Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand"
                                    ToolTip="粘贴为纯文本（丢弃格式，等效 Ctrl+Enter）">
                                <TextBlock Text="T" FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRich}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Click="OnPinToggle" Width="24" Height="24" MinHeight="0" Padding="0"
                                    Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand"
                                    ToolTip="固定到顶部 / 取消固定">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeCaption}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE718;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                    <Setter Property="Text" Value="&#xE77A;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NavAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Click="OnDeleteRow" Width="24" Height="24" MinHeight="0" Padding="0"
                                    Margin="2,0,0,0"
                                    Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand"
                                    ToolTip="删除该条">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 行容器：只管选中描边（hover 由行按钮自带），焦点不进列表防抢搜索框。
             内容拉满容器宽：否则行按钮只按内容收缩，点击命中不覆盖整行。 -->
        <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="{StaticResource CornerRadiusControl}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NavAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:ClipTemplateSelector x:Key="RowSelector"
                                    HeaderTemplate="{StaticResource HeaderTemplate}"
                                    ItemTemplate="{StaticResource ClipTemplate}"/>

        <!-- 类别 Tab（DESIGN.md 已登记特例）：胶囊式单选，选中 = 强调色文字 + 软底，hover 100/150ms -->
        <Style x:Key="TabRadioStyle" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="{StaticResource CornerRadiusControl}"
                                    Background="{DynamicResource NavHoverBackground}" Opacity="0"/>
                            <ContentPresenter Margin="12,4,12,4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource NavAccent}"/>
                                <!-- 选中底：18% 不透明度的强调色软底（比 hover 底更实的选中感） -->
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource NavAccent}"/>
                                <Setter TargetName="Hover" Property="Opacity" Value="0.18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root"
            CornerRadius="{StaticResource CornerRadiusOverlay}"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource WindowBorderColor}"
            BorderThickness="1"
            Opacity="0"
            Padding="16,12,16,12"
            MinHeight="120">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 搜索条（命令面板同款：图标 + 透明平贴输入框 + 空态占位） -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextHint}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchInput"
                             TextChanged="OnSearchTextChanged"
                             Background="Transparent" BorderThickness="0" Padding="0,5"
                             FontSize="{DynamicResource FontSizeBody}"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="SearchHint" Text="搜索内容 / 来源应用…"
                               IsHitTestVisible="False" Visibility="Collapsed"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextHint}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- 类别 Tab：搜索条与列表之间（2026-10-18 用户拍板），与搜索词叠加过滤 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="TabAll" Content="全部" Tag="all" GroupName="ClipTabs"
                             Style="{StaticResource TabRadioStyle}" IsChecked="True" Checked="OnTabChanged"/>
                <RadioButton Content="文本" Tag="text" GroupName="ClipTabs"
                             Style="{StaticResource TabRadioStyle}" Margin="4,0,0,0" Checked="OnTabChanged"/>
                <RadioButton Content="图片" Tag="image" GroupName="ClipTabs"
                             Style="{StaticResource TabRadioStyle}" Margin="4,0,0,0" Checked="OnTabChanged"/>
                <RadioButton Content="文件" Tag="files" GroupName="ClipTabs"
                             Style="{StaticResource TabRadioStyle}" Margin="4,0,0,0" Checked="OnTabChanged"/>
                <RadioButton Content="链接" Tag="link" GroupName="ClipTabs"
                             Style="{StaticResource TabRadioStyle}" Margin="4,0,0,0" Checked="OnTabChanged"/>
            </StackPanel>

            <!-- 历史列表：无上限 → 必须虚拟化；超高滚动 -->
            <ListBox x:Name="HistoryList" Grid.Row="2" MaxHeight="520"
                     Background="Transparent" BorderThickness="0" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ItemTemplateSelector="{StaticResource RowSelector}"
                     ItemContainerStyle="{StaticResource RowItemStyle}"
                     Margin="0,2,0,0"/>
            <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="暂无记录"
                       FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource TextHint}"
                       Margin="0,4,0,8" Visibility="Collapsed"/>

            <!-- 页脚提示 -->
            <TextBlock Grid.Row="3" Text="↑↓ 选择 · Ctrl+点击 多选 · Enter 粘贴 · Ctrl+Enter 纯文本 · Esc 退"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextHint}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>
