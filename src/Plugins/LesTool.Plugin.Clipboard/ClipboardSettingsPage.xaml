<UserControl x:Class="LesTool.Plugin.ClipboardHistory.ClipboardSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LesTool.Platform.Controls;assembly=LesTool.Platform">
    <!-- 剪切板历史设置页（PLUGIN_UI_SPEC）：行为区（回贴默认开 2026-10-18 拍板、免记录排除
         默认关 = 全记录，用户知情选择）+ 维护区（危险动作永远最后：三级红字 + 两击确认）。
         页框由宿主统一包装；统计文案由 code-behind 写入维护区 Caption。 -->
    <StackPanel>
        <controls:SettingsSection Title="行为">
            <StackPanel>
                <controls:CheckRow x:Name="PasteBackCheck"
                                   Text="回贴：选中条目后自动粘贴回原窗口（目标窗口拒收时降级为仅复制并提示）"
                                   Toggled="OnPasteBackChanged"/>
                <controls:CheckRow x:Name="ExcludeCheck"
                                   Text="跳过带免记录标记的内容（密码管理器等声明的复制不进历史；默认关 = 全部记录）"
                                   Toggled="OnExcludeChanged"/>
            </StackPanel>
        </controls:SettingsSection>

        <controls:SettingsSection x:Name="MaintenanceSection" Title="维护" Caption="当前 …">
            <Button x:Name="ClearButton" Content="清空全部历史" MinWidth="140" HorizontalAlignment="Left"
                    Foreground="{DynamicResource DangerBrush}"
                    Click="OnClearClick"/>
        </controls:SettingsSection>
    </StackPanel>
</UserControl>
