<UserControl x:Class="LesTool.Plugin.DownloadRouter.RouterSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LesTool.Plugin.DownloadRouter"
             xmlns:controls="clr-namespace:LesTool.Platform.Controls;assembly=LesTool.Platform">
    <!-- 下载归档设置页（PLUGIN_UI_SPEC）：四区 SettingsSection（启用与整理 / 监视与防抖 /
         分发规则 / 搬运账本），页框（滚动/边距/页头/热键区）由宿主统一包装。
         遵 DESIGN.md：不用无隐式样式的 ComboBox/ListBox/GroupBox/TabControl（一律
         ItemsControl + RadioButton + SettingsSection）；一行一控件（一行一项铁律）；
         插件引用宿主资源一律 DynamicResource；一页一个主操作 = 立即整理。 -->
    <StackPanel>
        <controls:SettingsSection Title="启用与整理"
                                  Caption="哨兵监视下载文件夹，按规则把新文件自动归类。安全底线：半成品不动、文件没安静不动、无规则认领不动、重名永不覆盖；每笔搬运记入账本，失败时源文件原地保留。">
            <StackPanel>
                <controls:CheckRow x:Name="EnabledCheck"
                                   Text="启用自动归档（关闭 = 哨兵暂停；「立即整理下载」命令仍可用）"
                                   Toggled="OnEnabledChanged"/>
                <Button Content="立即整理" Style="{DynamicResource PrimaryButtonStyle}"
                        MinWidth="96" HorizontalAlignment="Left" Click="OnOrganizeClick"
                        ToolTip="对监视夹做一次全量整理（与「立即整理下载」命令同源）"/>
            </StackPanel>
        </controls:SettingsSection>

        <controls:SettingsSection Title="监视与防抖"
                                  Caption="改动即时生效。安静等待 = 新文件落地后安静多久才算落稳；免等扩展名免排队不免安检（跳过等待，仍须文件完全撒手），浏览器下载完成的改名落地自动免等。">
            <StackPanel>
                <controls:SettingsRow Label="监视文件夹">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WatchFolderBox" Margin="0,0,8,0" VerticalAlignment="Center"
                                 LostFocus="OnWatchFolderCommitted"/>
                        <Button Grid.Column="1" Content="浏览…" MinWidth="72" Click="OnBrowseWatchFolder"/>
                    </Grid>
                </controls:SettingsRow>
                <controls:SettingsRow Label="安静等待">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="DebounceBox" Width="64" VerticalAlignment="Center"
                                 LostFocus="OnDebounceCommitted"/>
                        <TextBlock Text=" 秒" VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextHint}"/>
                    </StackPanel>
                </controls:SettingsRow>
                <controls:SettingsRow Label="免等扩展名" Help="逗号分隔，如 torrent, txt">
                    <TextBox x:Name="FastLaneBox" Width="200" VerticalAlignment="Center"
                             LostFocus="OnFastLaneCommitted"/>
                </controls:SettingsRow>
                <controls:SettingsRow Label="启动补扫">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SweepPrompt" GroupName="Sweep" Tag="Prompt" Margin="0,0,16,0"
                                     Content="有候选时提示（默认）" Checked="OnSweepChanged"/>
                        <RadioButton x:Name="SweepAuto" GroupName="Sweep" Tag="Auto" Margin="0,0,16,0"
                                     Content="全自动补扫" Checked="OnSweepChanged"/>
                        <RadioButton x:Name="SweepOff" GroupName="Sweep" Tag="Off"
                                     Content="关闭" Checked="OnSweepChanged"/>
                    </StackPanel>
                </controls:SettingsRow>
            </StackPanel>
        </controls:SettingsSection>

        <controls:SettingsSection Title="分发规则"
                                  Caption="从上到下先命中先得；扩展名与关键字都填 = 须同时满足，都留空 = 认领一切；目标文件夹必填（缺目标的行不生效）。失焦即保存，↑↓ 调优先级。">
            <StackPanel>
                <ItemsControl x:Name="RuleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:RuleRow}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                          ToolTip="启用 / 停用"
                                          IsChecked="{Binding Enabled}"
                                          Checked="OnRuleEdited" Unchecked="OnRuleEdited"/>
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,8,0" LostFocus="OnRuleEdited" ToolTip="规则名称"/>
                                <TextBox Grid.Column="2" Text="{Binding Extensions, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,8,0" LostFocus="OnRuleEdited"
                                         ToolTip="逗号分隔，如 zip,7z,rar；留空 = 不限"/>
                                <TextBox Grid.Column="3" Text="{Binding NameContains, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,8,0" LostFocus="OnRuleEdited"
                                         ToolTip="文件名包含（不区分大小写）；留空 = 不限"/>
                                <TextBox Grid.Column="4" Text="{Binding TargetDir, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,8,0" LostFocus="OnRuleEdited" ToolTip="目标文件夹（必填）"/>
                                <Button Grid.Column="5" MinWidth="32" Margin="0,0,4,0" Click="OnRuleUp"
                                        Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" ToolTip="上移（提高优先级）"/>
                                <Button Grid.Column="6" MinWidth="32" Margin="0,0,4,0" Click="OnRuleDown"
                                        Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" ToolTip="下移"/>
                                <Button Grid.Column="7" MinWidth="56" Click="OnRuleDelete" Content="删除"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="添加规则" Click="OnRuleAdd" MinWidth="96" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                <TextBlock Text="示例：名称「压缩包」、扩展名「zip,7z,rar」、目标「D:\Files\Archives」——下载夹里新落的压缩包约 6 秒后自动归位。"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextHint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </controls:SettingsSection>

        <controls:SettingsSection Title="搬运账本"
                                  Caption="最近 500 笔搬运记录（新在前）；失败条目的源文件原地保留，「定位」在资源管理器中打开所在位置。">
            <StackPanel>
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                        CornerRadius="{DynamicResource CornerRadiusOverlay}" Padding="12"
                        MaxHeight="220">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LedgerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LedgerRow}">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextHint}"
                                                   Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Outcome}" FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{Binding OutcomeBrush}"
                                                   Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Main}" FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Main}"/>
                                        <Button Grid.Column="3" Content="定位" MinWidth="48" Click="OnLedgerReveal"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <Button Content="刷新账本" Click="OnLedgerRefresh" MinWidth="96" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
        </controls:SettingsSection>
    </StackPanel>
</UserControl>
