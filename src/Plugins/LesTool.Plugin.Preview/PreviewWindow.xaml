<Window x:Class="LesTool.Plugin.Preview.PreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platform="clr-namespace:LesTool.Platform.Controls;assembly=LesTool.Platform"
        platform:NoSystemMenu.Enabled="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <!-- 空格预览浮窗：不抢资源管理器焦点（键盘由全局钩子代收），物理坐标直摆。
         外层 Margin 为阴影留白（铁律：分层透明窗阴影须 Margin 承载）。 -->
    <Border Margin="16">
        <Border x:Name="Root"
                CornerRadius="{StaticResource CornerRadiusOverlay}"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource WindowBorderColor}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
            </Border.Effect>
            <Grid Margin="16,12,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 头栏：文件名 + 元信息（类型 · 大小 · 修改时间） -->
                <TextBlock x:Name="FileName" Grid.Row="0"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Meta" Grid.Row="1"
                           Margin="0,2,0,12"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 内容区：渲染器按类型填充（图片/文本/文件夹/信息卡） -->
                <ContentControl x:Name="Body" Grid.Row="2"/>

                <!-- 底部提示 -->
                <TextBlock x:Name="Footer" Grid.Row="3"
                           Margin="0,10,0,0"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextHint}"
                           Text="空格 / Esc 关闭 · ↑↓ 切换选中文件"/>
            </Grid>
        </Border>
    </Border>
</Window>
