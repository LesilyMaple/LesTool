<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LesTool.Plugin.Screenshot</RootNamespace>
    <AssemblyName>LesTool.Plugin.Screenshot</AssemblyName>
    <Version>1.0.0</Version>
    <PluginId>screenshot</PluginId>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 库工程默认不把包程序集拷进 bin；插件产物要整体部署，强制落地（含原生库） -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- RID 指定后原生库（onnxruntime/skia）平铺在输出根目录，随 *.dll 一起部署；
         宿主 PluginLoadContext 按本插件 .deps.json 解析原生路径 -->
    <HostOutput>$(MSBuildProjectDirectory)\..\..\LesTool\bin\$(Configuration)\net8.0-windows\win-x64</HostOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <ProjectReference Include="..\..\LesTool.Platform\LesTool.Platform.csproj" />
  </ItemGroup>

  <!-- 构建即部署：dll（含原生库）→ plugins/screenshot/；模型（NuGet 拷到 TargetDir 的 + 仓库资产覆盖的）
       → assets/models/；清单 → plugin.json。仓库资产最后拷，同名覆盖 NuGet 版本 -->
  <Import Project="..\..\..\build\Plugin.Build.targets" />

</Project>
