<Window x:Class="LesTool.Plugin.Screenshot.LongBarWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LesTool 长截图控制条"
        WindowStyle="None" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual"
        Focusable="True" PreviewKeyDown="OnPreviewKeyDown">
    <Border Background="#E6101010" CornerRadius="4" Padding="8,5">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="StatusText" Text="滚动滚轮捕获" Foreground="White"
                       FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <Button Content="完成" Width="48" Height="24"
                    Background="#2E9E5B" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="OnFinishClick"/>
            <Button Content="取消" Width="48" Height="24" Margin="6,0,0,0"
                    Background="#B33A3A4A" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="OnCancelClick"/>
        </StackPanel>
    </Border>
</Window>
