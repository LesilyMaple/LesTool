<Window x:Class="LesTool.Plugin.Screenshot.RecordPreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LesTool.Platform.Controls;assembly=LesTool.Platform"
        Title="LesTool 录制预览"
        ResizeMode="CanResize"
        MinWidth="480" MinHeight="280"
        Background="Black" WindowStartupLocation="Manual"
        Focusable="True" PreviewKeyDown="OnPreviewKeyDown"
        Style="{StaticResource LesWindowStyle}">
    <DockPanel>
        <controls:CaptionBar DockPanel.Dock="Top"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 双击视频区全屏/还原 -->
            <MediaElement x:Name="Player" LoadedBehavior="Manual" Stretch="Uniform"
                          ScrubbingEnabled="True"
                          MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded"
                          MediaFailed="OnMediaFailed"
                          MouseLeftButtonDown="OnVideoMouseDown"/>
            <Border Grid.Row="1" Background="{DynamicResource PlayerBarBackground}" Padding="10,6">
                <DockPanel>
                    <!-- 左：播放控制 -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPlayPause" Content="暂停" Width="52"
                                ToolTip="播放/暂停（空格）" Click="OnPlayPauseClick"/>
                        <Button x:Name="BtnBack" Content="快退" Width="52" Margin="6,0,0,0"
                                ToolTip="后退 5 秒（←）" Click="OnSeekClick" Tag="-5"/>
                        <Button x:Name="BtnFwd" Content="快进" Width="52" Margin="6,0,0,0"
                                ToolTip="前进 5 秒（→）" Click="OnSeekClick" Tag="5"/>
                    </StackPanel>
                    <!-- 右：倍速/循环 + 保存/丢弃 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnSpeed" Content="1.0x" Width="52"
                                ToolTip="倍速（点击切换）" Click="OnSpeedClick"/>
                        <Button x:Name="BtnLoop" Content="循环" Width="52" Margin="6,0,0,0"
                                ToolTip="循环播放（L）" Click="OnLoopClick"/>
                        <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource WindowBorderColor}"/>
                        <Button Content="保存" Width="52" Margin="8,0,0,0"
                                Background="#2E9E5B" Foreground="White"
                                Click="OnSaveClick"/>
                        <Button Content="丢弃" Width="52" Margin="6,0,0,0" Click="OnDiscardClick"/>
                    </StackPanel>
                    <!-- 中：时间 + 进度条（点击跳转，拖动精确 seek） -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock x:Name="PosText" Text="0:00" Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="Consolas" VerticalAlignment="Center"/>
                        <Slider x:Name="Seek" MinWidth="120" Margin="8,0" VerticalAlignment="Center"
                                IsMoveToPointEnabled="True" Minimum="0" SmallChange="1" LargeChange="5"
                                Thumb.DragStarted="OnSeekDragStarted"
                                Thumb.DragCompleted="OnSeekDragCompleted"
                                ValueChanged="OnSeekValueChanged"/>
                        <TextBlock x:Name="DurText" Text="0:00" Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
