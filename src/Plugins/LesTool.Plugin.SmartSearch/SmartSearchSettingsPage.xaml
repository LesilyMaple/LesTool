<UserControl x:Class="LesTool.Plugin.SmartSearch.SmartSearchSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LesTool.Plugin.SmartSearch"
             xmlns:controls="clr-namespace:LesTool.Platform.Controls;assembly=LesTool.Platform">
    <!-- 智能搜索设置页（PLUGIN_UI_SPEC）：三区 SettingsSection（搜索引擎 / 识别开关 / 自定义规则），
         页框（滚动/边距/页头/热键区）由宿主统一包装；即时生效即时落盘。
         行内 TextBox 绑定 TwoWay（LostFocus 提交），失焦即保存；工厂每次进页重建。 -->
    <StackPanel>
        <controls:SettingsSection Title="搜索引擎"
                                  Caption="默认引擎用于未识别文本的兜底搜索；前缀用于输入条（如 gh + 空格 + 搜索词）。网址里的 {0} 是搜索词占位。">
            <StackPanel>
                <ItemsControl x:Name="EngineList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SearchEngine}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" GroupName="DefaultEngine" VerticalAlignment="Center"
                                             Margin="0,0,10,0" ToolTip="设为默认引擎（兜底搜索用）"
                                             IsChecked="{Binding IsDefault}" Checked="OnDefaultEngineChecked"/>
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                         LostFocus="OnEngineEdited" Margin="0,0,6,0" ToolTip="引擎名称"/>
                                <TextBox Grid.Column="2" Text="{Binding Prefix, UpdateSourceTrigger=LostFocus}"
                                         LostFocus="OnEngineEdited" Margin="0,0,6,0" ToolTip="输入条前缀（可空）"/>
                                <TextBox Grid.Column="3" Text="{Binding Url, UpdateSourceTrigger=LostFocus}"
                                         LostFocus="OnEngineEdited" Margin="0,0,6,0"
                                         FontFamily="Consolas" ToolTip="网址模板，{0} 为搜索词占位"/>
                                <Button Grid.Column="4" Content="删除" Click="OnDeleteEngine" MinWidth="56"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="添加引擎" Click="OnAddEngine" MinWidth="96" HorizontalAlignment="Left" Margin="0,2,0,0"/>
            </StackPanel>
        </controls:SettingsSection>

        <controls:SettingsSection Title="识别开关"
                                  Caption="关闭后对应类型不再参与识别（例如嫌 av 号误识别就关掉B站项）。识别不出任何类型时走默认引擎。">
            <StackPanel x:Name="RecognizerPanel">
                <controls:CheckRow Text="网址" Tag="url" Toggled="OnRecognizerToggle"/>
                <controls:CheckRow Text="本机路径" Tag="path" Toggled="OnRecognizerToggle"/>
                <controls:CheckRow Text="算式" Tag="math" Toggled="OnRecognizerToggle"/>
                <controls:CheckRow Text="网盘链接" Tag="netdisk" Toggled="OnRecognizerToggle"/>
                <controls:CheckRow Text="B站视频号" Tag="bv" Toggled="OnRecognizerToggle"/>
                <controls:CheckRow Text="邮箱" Tag="email" Toggled="OnRecognizerToggle"/>
            </StackPanel>
        </controls:SettingsSection>

        <controls:SettingsSection Title="自定义识别规则"
                                  Caption="正则命中 → 打开网址模板，{0} 为命中文本（正则有捕获组时取组1）。优先级排在内置识别之后。预置示例（DOI / 快递单号）默认停用，想用勾开即可。">
            <StackPanel>
                <ItemsControl x:Name="RuleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CustomRule}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                          ToolTip="启用 / 停用"
                                          IsChecked="{Binding Enabled}" Checked="OnRuleToggled" Unchecked="OnRuleToggled"/>
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                         LostFocus="OnRuleEdited" Margin="0,0,6,0" ToolTip="规则名称（候选标题）"/>
                                <TextBox Grid.Column="2" Text="{Binding Pattern, UpdateSourceTrigger=LostFocus}"
                                         LostFocus="OnRuleEdited" Margin="0,0,6,0"
                                         FontFamily="Consolas" ToolTip="正则表达式"/>
                                <TextBox Grid.Column="3" Text="{Binding Url, UpdateSourceTrigger=LostFocus}"
                                         LostFocus="OnRuleEdited" Margin="0,0,6,0"
                                         FontFamily="Consolas" ToolTip="网址模板，{0} 为命中文本"/>
                                <Button Grid.Column="4" Content="删除" Click="OnDeleteRule" MinWidth="56"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="添加规则" Click="OnAddRule" MinWidth="96" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                <TextBlock Text="示例：公司名查企查查 —— 名称「查公司」、正则「.+公司$」、网址「https://www.qcc.com/web/search?key={0}」"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextHint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </controls:SettingsSection>
    </StackPanel>
</UserControl>
