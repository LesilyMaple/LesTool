<Window x:Class="LesTool.Plugin.SmartSearch.SmartSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LesTool.Plugin.SmartSearch"
        xmlns:platform="clr-namespace:LesTool.Platform.Controls;assembly=LesTool.Platform"
        platform:GlassWindow.Enabled="True"
        platform:NoSystemMenu.Enabled="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="560"
        WindowStartupLocation="Manual"
        Focusable="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <!-- 智能搜索浮窗（面板窗一档表面：跟主题 + 圆角 + 1px 描边），光标右下方弹出。
         两模式共用一窗：输入模式（无选中文字时）= 图标 + 输入条；列表模式 = 候选清单。
         Root 常态 Opacity=0：预创建预热与淡出后均不可见。窗口协议沿命令面板/剪切板面板。 -->
    <Window.Resources>
        <!-- 候选行：图标 | 标题+说明（说明单行截断）。行按钮 CommandItemStyle 自带 hover；
             内容拉满容器宽，否则点击命中不覆盖整行 -->
        <DataTemplate x:Key="CandidateTemplate" DataType="{x:Type local:SmartCandidate}">
            <Button Style="{StaticResource CommandItemStyle}" Padding="10,7" Click="OnRowClick">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource NavAccent}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextHint}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 行容器：只管选中描边（hover 由行按钮自带），焦点不进列表防打断键盘导航 -->
        <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="{StaticResource CornerRadiusControl}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource NavAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root"
            CornerRadius="{StaticResource CornerRadiusOverlay}"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource WindowBorderColor}"
            BorderThickness="1"
            Opacity="0"
            Padding="16,12,16,12"
            MinHeight="52">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 输入模式：图标 + 输入条 + 占位提示（命令面板同款） -->
            <StackPanel x:Name="InputPanel" Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextHint}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="QueryInput"
                                 TextChanged="OnQueryTextChanged"
                                 Background="Transparent" BorderThickness="0" Padding="0,5"
                                 FontSize="{DynamicResource FontSizeBody}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="InputHint" Text="输入文字识别执行，或 前缀+空格 指定引擎…"
                                   IsHitTestVisible="False" Visibility="Collapsed"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextHint}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- 列表模式：候选清单（与输入模式互斥切换） -->
            <StackPanel x:Name="ListPanel" Grid.Row="0" Visibility="Collapsed">
                <ListBox x:Name="CandidateList" MaxHeight="380"
                         Background="Transparent" BorderThickness="0" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemTemplate="{StaticResource CandidateTemplate}"
                         ItemContainerStyle="{StaticResource RowItemStyle}"/>
            </StackPanel>

            <!-- 页脚提示（按模式切换文案） -->
            <TextBlock x:Name="FooterHint" Grid.Row="1"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextHint}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>
